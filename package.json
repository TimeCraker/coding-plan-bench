{
  "name": "coding-plan-bench",
  "version": "0.1.0",
  "private": true,
  "description": "可信测速台：三种执行位置测量 LLM TTFT/TPS/Total / Trusted benchmark with explicit transports",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx server/node.ts",
    "bench:matrix": "tsx bench/run.ts",
    "tauri": "tauri",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/integration/proxy-security.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:responsive": "playwright test tests/e2e/responsive.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:docs": "vitest run tests/config/docs-config.test.ts",
    "test:deploy-config": "vitest run tests/config/deploy-config.test.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit -- --run && npm run test:integration -- --run && npm run test:security && npm run test:e2e && npm run test:a11y && npm run test:responsive && npm run test:visual && npm run build && npm run check:bundle && npm run check:clean"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.8.0",
    "hono": "^4.12.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260731.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.116.0"
  }
}
