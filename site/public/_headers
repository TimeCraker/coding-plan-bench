# Cloudflare Pages 安全头（Spec §4.4 / NFR-001）
# 站点无内联脚本/样式（单浅色主题无需引导脚本；组件样式为静态 Tailwind）

/*
  Content-Security-Policy: default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Cache-Control: no-cache

# 带 hash 的静态资源可长缓存（Spec §4.7：immutable hash cache，HTML no-cache）
/assets/*
  Cache-Control: public, max-age=31536000, immutable
