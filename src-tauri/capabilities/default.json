{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力：核心权限 + HTTP 插件（仅 HTTPS 远程目标，本地版只需直连 provider）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" }
      ]
    }
  ]
}
