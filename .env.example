# ── Coding Plan Bench · 模型矩阵 API Key ──
# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore，不会入库）
# Key 从各自控制台获取，均为订阅套餐专用 Key

# 智谱开放平台（glm-5.3 / glm-5.3-flash 同一把 key，bench:matrix 用）
# https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 智谱 GLM Coding Plan（v1 渠道，glm-5.2）
# https://bigmodel.cn/coding-plan/personal/overview
ZAI_CODING_CN_API_KEY=

# 火山方舟 Ark Coding Plan
# https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
VOLCENGINE_CODING_API_KEY=

# 百度千帆 Qianfan Token Plan
# https://console.bce.baidu.com/qianfan
QIANFAN_API_KEY=
